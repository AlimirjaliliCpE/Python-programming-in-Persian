import codecs
import keyword
import os
import queue
import re
import subprocess
import sys
import tempfile
import threading
import tkinter as tk
from tkinter import filedialog, font, messagebox

import ali_lang

if len(sys.argv) > 1 and sys.argv[1] == "--run":
    sys.exit(ali_lang.main(sys.argv[2:]))

BG = "#1e1e2e"
FG = "#cdd6f4"
GUTTER_BG = "#181825"
GUTTER_FG = "#6c7086"
OUTPUT_BG = "#11111b"
BAR_BG = "#313244"
COLORS = {
    "kw": "#cba6f7",
    "builtin": "#89b4fa",
    "string": "#a6e3a1",
    "number": "#fab387",
    "comment": "#6c7086",
}

PY_KEYWORDS = set(keyword.kwlist)

TOKEN_RE = re.compile("|".join([
    r"(?P<comment>#[^\n]*)",
    r"""(?P<string>[rbfuRBFU]{0,2}(?:\"\"\"[\s\S]*?(?:\"\"\"|\Z)|'''[\s\S]*?(?:'''|\Z)"""
    r"""|"(?:\\.|[^"\\\n])*"?|'(?:\\.|[^'\\\n])*'?))""",
    r"(?P<number>[\d٫]+)",
    "(?P<word>" + ali_lang.WORD.pattern + ")",
]))


