class AliIDE:
    def __init__(self, root):
        self.root = root
        self.path = None
        self.dirty = False
        self.proc = None
        self.temp_path = None
        self.output_queue = queue.Queue()
        self.refresh_job = None

        self.pick_fonts()
        self.build_menu()
        self.build_toolbar()
        self.build_panes()
        self.build_statusbar()
        self.bind_keys()

        self.load_text(EXAMPLES["سلام دنیا"])
        self.root.protocol("WM_DELETE_WINDOW", self.quit)
        self.root.after(50, self.pump_output)


    def pick_fonts(self):
        available = set(font.families())
        choices = ["Vazir Code", "Vazirmatn", "Sahel", "Tahoma", "Segoe UI",
                   "DejaVu Sans Mono", "Courier New"]
        name = next((f for f in choices if f in available), "Courier")
        self.code_font = font.Font(family=name, size=14)
        self.ui_font = font.Font(family=name, size=11)

    def build_menu(self):
        bar = tk.Menu(self.root)

        file_menu = tk.Menu(bar, tearoff=0)
        file_menu.add_command(label="جدید", accelerator="Ctrl+N", command=self.new_file)
        file_menu.add_command(label="باز کردن...", accelerator="Ctrl+O", command=self.open_file)
        file_menu.add_command(label="ذخیره", accelerator="Ctrl+S", command=self.save_file)
        file_menu.add_command(label="ذخیره به نام...", command=self.save_as)
        file_menu.add_separator()
        file_menu.add_command(label="خروج", command=self.quit)
        bar.add_cascade(label="فایل", menu=file_menu)

        run_menu = tk.Menu(bar, tearoff=0)
        run_menu.add_command(label="اجرا", accelerator="F5", command=self.run)
        run_menu.add_command(label="توقف", accelerator="Shift+F5", command=self.stop)
        run_menu.add_command(label="نمایش کد پایتون", command=self.show_python)
        bar.add_cascade(label="اجرا", menu=run_menu)

        examples_menu = tk.Menu(bar, tearoff=0)
        for title in EXAMPLES:
            examples_menu.add_command(label=title, command=lambda t=title: self.load_example(t))
        bar.add_cascade(label="نمونه‌ها", menu=examples_menu)

        help_menu = tk.Menu(bar, tearoff=0)
        help_menu.add_command(label="فهرست کلمات فارسی", command=self.show_keywords)
        bar.add_cascade(label="راهنما", menu=help_menu)

        self.root.config(menu=bar)

    def build_toolbar(self):
        bar = tk.Frame(self.root, bg=BAR_BG)
        bar.pack(fill="x")
        buttons = [
            ("▶  اجرا (F5)", self.run),
            ("■  توقف", self.stop),
            ("ذخیره", self.save_file),
            ("کد پایتون", self.show_python),
        ]
        for text, command in buttons:
            tk.Button(bar, text=text, command=command, font=self.ui_font, relief="flat",
                      bg=BAR_BG, fg=FG, activebackground="#45475a", activeforeground=FG,
                      padx=12, pady=4).pack(side="left", padx=2, pady=3)

    def build_panes(self):
        panes = tk.PanedWindow(self.root, orient="vertical", sashwidth=6, bg=BAR_BG)
        panes.pack(fill="both", expand=True)

        
        editor_frame = tk.Frame(panes, bg=BG)
        self.gutter = tk.Text(editor_frame, width=4, padx=6, pady=4, border=0, takefocus=0,
                              font=self.code_font, bg=GUTTER_BG, fg=GUTTER_FG,
                              state="disabled", cursor="arrow", wrap="none")
        self.gutter.tag_configure("right", justify="right")
        self.gutter.bind("<MouseWheel>", lambda e: "break")
        self.scrollbar = tk.Scrollbar(editor_frame)
        self.editor = tk.Text(editor_frame, wrap="none", undo=True, border=0, padx=8, pady=4,
                              font=self.code_font, bg=BG, fg=FG, insertbackground=FG,
                              selectbackground="#45475a", yscrollcommand=self.on_scroll)
        self.scrollbar.config(command=self.editor.yview)
        self.gutter.pack(side="left", fill="y")
        self.scrollbar.pack(side="right", fill="y")
        self.editor.pack(side="left", fill="both", expand=True)
        for tag, color in COLORS.items():
            self.editor.tag_configure(tag, foreground=color)
        self.editor.tag_configure("comment", font=self.code_font)
        panes.add(editor_frame, minsize=150, stretch="always")

        
        output_frame = tk.Frame(panes, bg=OUTPUT_BG)
        input_row = tk.Frame(output_frame, bg=BAR_BG)
        input_row.pack(side="bottom", fill="x")
        tk.Label(input_row, text="ورودی:", bg=BAR_BG, fg=FG, font=self.ui_font).pack(side="left", padx=6)
        self.input_entry = tk.Entry(input_row, font=self.ui_font, bg=OUTPUT_BG, fg=FG,
                                    insertbackground=FG, relief="flat")
        self.input_entry.pack(side="left", fill="x", expand=True, padx=4, pady=4)
        self.input_entry.bind("<Return>", self.send_input)

        out_scroll = tk.Scrollbar(output_frame)
        out_scroll.pack(side="right", fill="y")
        self.output = tk.Text(output_frame, height=9, wrap="word", border=0, padx=8, pady=4,
                              font=self.code_font, bg=OUTPUT_BG, fg=FG, state="disabled",
                              yscrollcommand=out_scroll.set)
        out_scroll.config(command=self.output.yview)
        self.output.tag_configure("info", foreground="#f9e2af")
        self.output.pack(side="left", fill="both", expand=True)
        panes.add(output_frame, minsize=80)

    def build_statusbar(self):
        self.status = tk.StringVar(value="آماده")
        tk.Label(self.root, textvariable=self.status, anchor="w", bg=BAR_BG, fg=FG,
                 font=self.ui_font, padx=8).pack(fill="x", side="bottom")

    def bind_keys(self):
        self.editor.bind("<Return>", self.on_return)
        self.editor.bind("<Tab>", self.on_tab)
        self.editor.bind("<<Modified>>", self.on_modified)
        self.root.bind("<F5>", lambda e: self.run())
        self.root.bind("<Shift-F5>", lambda e: self.stop())
        self.root.bind("<Control-s>", lambda e: self.save_file())
        self.root.bind("<Control-o>", lambda e: self.open_file())
        self.root.bind("<Control-n>", lambda e: self.new_file())

   
    def on_scroll(self, first, last):
        self.scrollbar.set(first, last)
        self.gutter.yview_moveto(first)

    def on_return(self, event):
        line = self.editor.get("insert linestart", "insert")
        indent = line[:len(line) - len(line.lstrip(" "))]
        if line.rstrip().endswith(":"):
            indent += "    "
        self.editor.insert("insert", "\n" + indent)
        self.editor.see("insert")
        return "break"

    def on_tab(self, event):
        self.editor.insert("insert", "    ")
        return "break"

    def on_modified(self, event):
        if not self.editor.edit_modified():
            return
        self.editor.edit_modified(False)
        self.dirty = True
        self.update_title()
        if self.refresh_job:
            self.root.after_cancel(self.refresh_job)
        self.refresh_job = self.root.after(150, self.refresh)

    def refresh(self):
        self.refresh_job = None
        self.update_gutter()
        self.highlight()

    def update_gutter(self):
        count = int(self.editor.index("end-1c").split(".")[0])
        numbers = "\n".join(str(i) for i in range(1, count + 1))
        self.gutter.config(state="normal")
        self.gutter.delete("1.0", "end")
        self.gutter.insert("1.0", numbers, "right")
        self.gutter.config(state="disabled")
        self.gutter.yview_moveto(self.editor.yview()[0])

    def highlight(self):
        text = self.editor.get("1.0", "end-1c")
        for tag in COLORS:
            self.editor.tag_remove(tag, "1.0", "end")
        for match in TOKEN_RE.finditer(text):
            kind = match.lastgroup
            if kind == "word":
                word = ali_lang.normalize_word(match.group())
                if word not in ali_lang.KEYWORDS:
                    continue
                kind = "kw" if ali_lang.KEYWORDS[word] in PY_KEYWORDS else "builtin"
            self.editor.tag_add(kind, f"1.0+{match.start()}c", f"1.0+{match.end()}c")

    def load_text(self, text):
        self.editor.delete("1.0", "end")
        self.editor.insert("1.0", text)
        self.editor.edit_reset()
        self.editor.edit_modified(False)
        self.dirty = False
        self.refresh()
        self.update_title()

    def update_title(self):
        name = os.path.basename(self.path) if self.path else "بدون نام"
        star = " *" if self.dirty else ""
        self.root.title(f"{ali_lang.LANG_NAME} IDE - {name}{star}")


    def confirm_discard(self):
        if not self.dirty:
            return True
        return messagebox.askyesno("ذخیره نشده", "تغییرات ذخیره نشده‌اند. ادامه می‌دهی؟")

    def new_file(self):
        if self.confirm_discard():
            self.path = None
            self.load_text("")

    def load_example(self, title):
        if self.confirm_discard():
            self.path = None
            self.load_text(EXAMPLES[title])

    def open_file(self):
        if not self.confirm_discard():
            return
        path = filedialog.askopenfilename(
            filetypes=[(ali_lang.LANG_NAME, "*" + ali_lang.FILE_EXTENSION), ("همه‌ی فایل‌ها", "*.*")])
        if path:
            with open(path, encoding="utf-8-sig") as f:
                text = f.read()
            self.path = path
            self.load_text(text)

    def save_file(self):
        if not self.path:
            return self.save_as()
        with open(self.path, "w", encoding="utf-8") as f:
            f.write(self.editor.get("1.0", "end-1c"))
        self.dirty = False
        self.update_title()
        self.status.set("ذخیره شد")
        return True

    def save_as(self):
        path = filedialog.asksaveasfilename(
            defaultextension=ali_lang.FILE_EXTENSION,
            filetypes=[(ali_lang.LANG_NAME, "*" + ali_lang.FILE_EXTENSION)])
        if not path:
            return False
        self.path = path
        return self.save_file()


    def run(self):
        if self.proc is not None:
            return
        folder = os.path.dirname(self.path) if self.path else os.path.expanduser("~")
        temp = tempfile.NamedTemporaryFile("w", suffix=ali_lang.FILE_EXTENSION,
                                           delete=False, encoding="utf-8")
        temp.write(self.editor.get("1.0", "end-1c"))
        temp.close()
        self.temp_path = temp.name

        if getattr(sys, "frozen", False):
            command = [sys.executable, "--run", temp.name]
        else:
            command = [sys.executable, "-u", ali_lang.__file__, temp.name]
        env = dict(os.environ, PYTHONIOENCODING="utf-8", PYTHONUNBUFFERED="1")
        options = {"creationflags": 0x08000000} if os.name == "nt" else {}  # no black window

        self.clear_output()
        self.proc = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, cwd=folder, env=env, **options)
        threading.Thread(target=self.read_output, args=(self.proc,), daemon=True).start()
        self.status.set("در حال اجرا ...")
        self.input_entry.focus_set()

    def read_output(self, proc):
        """Runs in a thread: read the program output and pass it to the window."""
        decoder = codecs.getincrementaldecoder("utf-8")("replace")
        fd = proc.stdout.fileno()
        while True:
            try:
                data = os.read(fd, 4096)
            except OSError:
                break
            if not data:
                break
            self.output_queue.put(("text", decoder.decode(data)))
        self.output_queue.put(("done", proc.wait()))

    def pump_output(self):
        try:
            while True:
                kind, value = self.output_queue.get_nowait()
                if kind == "text":
                    self.write_output(value)
                else:
                    self.finish_run(value)
        except queue.Empty:
            pass
        self.root.after(50, self.pump_output)

    def finish_run(self, exit_code):
        self.proc = None
        self.write_output(f"\n--- اجرا تمام شد (کد خروج: {exit_code}) ---\n", "info")
        self.status.set("آماده")
        if self.temp_path and os.path.exists(self.temp_path):
            os.remove(self.temp_path)
        self.temp_path = None

    def stop(self):
        if self.proc is not None:
            self.proc.kill()

    def send_input(self, event):
        line = self.input_entry.get()
        self.input_entry.delete(0, "end")
        if self.proc is None:
            return
        self.write_output(line + "\n")
        try:
            self.proc.stdin.write((line + "\n").encode("utf-8"))
            self.proc.stdin.flush()
        except OSError:
            pass

    def write_output(self, text, tag=None):
        self.output.config(state="normal")
        self.output.insert("end", text, tag)
        self.output.see("end")
        self.output.config(state="disabled")

    def clear_output(self):
        self.output.config(state="normal")
        self.output.delete("1.0", "end")
        self.output.config(state="disabled")


    def show_text_window(self, title, text):
        window = tk.Toplevel(self.root)
        window.title(title)
        window.geometry("620x520")
        box = tk.Text(window, font=self.code_font, bg=BG, fg=FG, border=0, padx=10, pady=8)
        box.insert("1.0", text)
        box.config(state="disabled")
        box.pack(fill="both", expand=True)

    def show_python(self):
        python_code = ali_lang.translate(self.editor.get("1.0", "end-1c"))
        self.show_text_window("کد پایتون معادل", python_code)

    def show_keywords(self):
        lines = [f"{persian:<22} ->  {python_word}"
                 for persian, python_word in ali_lang.KEYWORDS.items()]
        self.show_text_window("فهرست کلمات فارسی", "\n".join(lines))

    def quit(self):
        if not self.confirm_discard():
            return
        self.stop()
        self.root.destroy()


def main():
    try:  
        import ctypes
        ctypes.windll.shcore.SetProcessDpiAwareness(1)
    except Exception:
        pass
    root = tk.Tk()
    root.geometry("900x700")
    AliIDE(root)
    root.mainloop()


if __name__ == "__main__":
    main()
